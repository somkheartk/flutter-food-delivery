# Backend Environment Variables

# Server Port
PORT=3000

# MongoDB Connection URI
MONGO_URI=mongodb://localhost:27017/food-delivery
# For MongoDB Atlas:
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/food-delivery

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production-use-strong-random-string
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production-use-different-string

# Redis Configuration (for future implementation)
REDIS_URL=redis://localhost:6379

# Google Maps API Key (for location features)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Firebase Cloud Messaging (for push notifications)
FCM_SERVER_KEY=your-fcm-server-key

# Payment Provider Configuration
PAYMENT_PROVIDER=omise
OMISE_PUBLIC_KEY=your-omise-public-key
OMISE_SECRET_KEY=your-omise-secret-key

# CORS Origin (use * for development, specific domain for production)
CORS_ORIGIN=*

# Node Environment
NODE_ENV=development
